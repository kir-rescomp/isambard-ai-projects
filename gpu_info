alias gpu-info='python3 -c "
import subprocess, re
out = subprocess.check_output([\"scontrol\",\"show\",\"partition\",\"workq\"]).decode()
gpus  = re.search(r\"gres/gpu=(\d+)\", out).group(1)
nodes = re.search(r\"node=(\d+)\",     out).group(1)
B,G,C,R = \"\033[1m\",\"\033[32m\",\"\033[36m\",\"\033[0m\"
print(f\"\n{B}Isambard-AI — workq partition{R}\")
print(f\"  {C}Nodes  {R}: {B}{nodes}{R}\")
print(f\"  {C}GPUs   {R}: {B}{G}{gpus}{R}  (NVIDIA GH200 H100)\")
print(f\"  {C}Per node{R}: 4 GPUs × 96 GB HBM3 = 384 GB VRAM\")
print(f\"  {C}Total   {R}: {int(nodes)*384:,} GB VRAM across all nodes\n\")
"'
